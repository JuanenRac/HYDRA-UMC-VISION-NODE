# =============================================================================
# --workspace points at a real root:root 0755 tree under /opt (see
# install_vision_node.sh) holding just this node's 4 real children's own
# hydra-umc.project.json files, so GET /family-status has a real,
# non-empty default to check without a caller having to pass ?workspace=
# on every request. Deliberately NOT a symlink to the real sibling-repo
# checkout root - real bug found live on this device's first install:
# that root lives under the operator's home directory (0700, Debian's
# own default), unreadable by this service's own unprivileged account no
# matter how ProtectHome is set. ProtectHome stays this family's usual
# "true" - nothing under /home/ needs to be reachable any more.
[Unit]
Description=HYDRA-UMC-VISION-NODE real family/pipeline-status API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-vision-node
Group=hydra-umc-vision-node
WorkingDirectory=/opt/hydra-umc/vision-node
Environment=PYTHONPATH=/opt/hydra-umc/vision-node/src
ExecStart=/usr/bin/python3 -m hydra_umc_vision_node.main serve --addr 127.0.0.1 --port 8094 --workspace /opt/hydra-umc/vision-node/workspace
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
